<Project>

  <!--
    Where the game's mod loader lives. The default is r2modman's Default profile for
    Waterpark Simulator. To build against another location, create GamePaths.user.props
    next to this file (it is ignored by git) and set ProfileDir there.
  -->
  <Import Project="GamePaths.user.props" Condition="Exists('$(MSBuildThisFileDirectory)GamePaths.user.props')" />

  <PropertyGroup>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(APPDATA)\r2modmanPlus-local\WaterparkSimulator\profiles\Default</ProfileDir>
    <BepInExDir>$(ProfileDir)\BepInEx</BepInExDir>
    <BepInExCoreDir>$(BepInExDir)\core</BepInExCoreDir>
    <!-- Generated by BepInEx on the first modded launch of the game. -->
    <InteropDir>$(BepInExDir)\interop</InteropDir>
    <PluginDeployDir>$(BepInExDir)\plugins\ParkStats</PluginDeployDir>
  </PropertyGroup>

</Project>
