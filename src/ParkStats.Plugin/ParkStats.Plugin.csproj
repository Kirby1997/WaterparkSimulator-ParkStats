<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\GamePaths.props" />

  <PropertyGroup>
    <!-- BepInEx IL2CPP hosts plugins on its bundled .NET 6 runtime. -->
    <TargetFramework>net6.0</TargetFramework>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Off: the interop assemblies expose their own NullableAttribute, which breaks the compiler's. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.2.0</Version>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ParkStats.Core\ParkStats.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core" HintPath="$(BepInExCoreDir)\BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(BepInExCoreDir)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)\0Harmony.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(BepInExCoreDir)\Il2CppInterop.Runtime.dll" Private="false" />
    <!-- The game's own types, as proxy assemblies generated by BepInEx. -->
    <Reference Include="$(InteropDir)\*.dll" Private="false" />
  </ItemGroup>

  <Target Name="CheckGameFiles" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.Core.dll')"
           Text="BepInEx not found in '$(BepInExDir)'. Install BepInExPack_IL2CPP with r2modman, or set ProfileDir in GamePaths.user.props." />
    <Error Condition="!Exists('$(InteropDir)\Assembly-CSharp.dll')"
           Text="Game interop assemblies not found in '$(InteropDir)'. Start the game once with BepInEx installed so it generates them." />
  </Target>

  <Target Name="DeployPlugin" AfterTargets="Build">
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)ParkStats.*.dll" />
      <!-- When the mod is installed through r2modman it lives in <Team>-ParkStats; build over that copy. -->
      <ManagedCopy Include="$(BepInExDir)\plugins\*-ParkStats\ParkStats.Plugin.dll" />
    </ItemGroup>
    <PropertyGroup Condition="'@(ManagedCopy)' != ''">
      <PluginDeployDir>%(ManagedCopy.RootDir)%(ManagedCopy.Directory)</PluginDeployDir>
    </PropertyGroup>
    <!-- A copy built before the mod was installed through r2modman would load as a duplicate. -->
    <RemoveDir Directories="$(BepInExDir)\plugins\ParkStats" Condition="'@(ManagedCopy)' != ''" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(PluginDeployDir)" />
    <Message Importance="high" Text="Deployed @(DeployFiles->'%(Filename)%(Extension)', ', ') to $(PluginDeployDir)" />
  </Target>

  <!-- dotnet build src/ParkStats.Plugin -c Release -t:PackThunderstore -->
  <Target Name="PackThunderstore" DependsOnTargets="Build">
    <PropertyGroup>
      <RepoRoot>$(MSBuildThisFileDirectory)..\..\</RepoRoot>
      <StageDir>$(RepoRoot)dist\stage\</StageDir>
      <PackageZip>$(RepoRoot)dist\ParkStats-$(Version).zip</PackageZip>
      <ManifestText>$([System.IO.File]::ReadAllText('$(RepoRoot)thunderstore\manifest.json'))</ManifestText>
      <PluginText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)Plugin.cs'))</PluginText>
    </PropertyGroup>
    <!-- The version lives in three places; refuse to package when they disagree. -->
    <Error Condition="!$(ManifestText.Contains('&quot;version_number&quot;: &quot;$(Version)&quot;'))"
           Text="thunderstore/manifest.json version_number does not match $(Version)." />
    <Error Condition="!$(PluginText.Contains('Version = &quot;$(Version)&quot;'))"
           Text="Plugin.Version in Plugin.cs does not match $(Version)." />
    <RemoveDir Directories="$(StageDir)" />
    <Copy SourceFiles="$(RepoRoot)thunderstore\manifest.json;$(RepoRoot)thunderstore\icon.png;$(RepoRoot)README.md;$(RepoRoot)CHANGELOG.md"
          DestinationFolder="$(StageDir)" />
    <Copy SourceFiles="$(TargetDir)ParkStats.Plugin.dll;$(TargetDir)ParkStats.Core.dll" DestinationFolder="$(StageDir)plugins" />
    <Delete Files="$(PackageZip)" />
    <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="$(PackageZip)" />
    <RemoveDir Directories="$(StageDir)" />
    <Message Importance="high" Text="Thunderstore package: $(PackageZip)" />
  </Target>

</Project>
